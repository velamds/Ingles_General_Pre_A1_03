{"_data": [{"contents": [{"content": "Places and People", "type": "lesson_name"}, {"content": "Are There Any Pencils?", "type": "unit_name"}, {"content": 11, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "Beginner", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Asking and Saying Where Things Are", "type": "heading"}, {"content": "You use <span class=\"strong\">there is</span> or <span class=\"strong\">there are</span> to indicate that something is in a specific place. <br /> You use <span class=\"strong\">is there</span> or <span class=\"strong\">are there</span> to ask about something. <br />You use <span class=\"strong\">where is</span> or <span class=\"strong\">where are</span> to ask where something is.", "type": "describer"}, {"content": "{\"rows\":\"4\",\"columns\":\"3\",\"cells\":[\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Singular</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Plural</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Statements with <span class=\\\"italic\\\">There\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"There is <br/>There's  <br/><span class=\\\"italic\\\">Example: There's a blue pen in the living room.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"There are <br/><br/> <span class=\\\"italic\\\">Example: There are erasers in the kitchen.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Questions with <span class=\\\"italic\\\">There\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Is there \u2026 ?  <br/><br/><span class=\\\"italic\\\">Example: Is there a shirt in the bedroom?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Are there \u2026 ?  <br/><br/><span class=\\\"italic\\\">Example: Are there any pencils in the house?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Questions with <span class=\\\"italic\\\">Where\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Where is \u2026 ? <br/>Where's \u2026 ?  <br/><span class=\\\"italic\\\">Example: Where's the notebook?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Where are \u2026 ?  <br/><br/> <span class=\\\"italic\\\">Example: Where are the erasers?\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "pencil", "type": "name"}, {"content": "an object we use for writing or drawing", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Can I use your pencil? I want  to write a note. ", "type": "example"}, {"content": "engenn1le03ob11aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are the words to review.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "eraser", "type": "name"}, {"content": "a small object we use to remove pencil marks", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Do you have an eraser? I need to change something.", "type": "example"}, {"content": "engenn1le03ob11aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "pencil sharpener ", "type": "name"}, {"content": "an object we use to make pencils ready to write", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I need a pencil sharpener to use this pencil.", "type": "example"}, {"content": "engenn1le03ob11aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "kitchen", "type": "name"}, {"content": "a room where people eat and cook food", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The fridge is in the kitchen.", "type": "example"}, {"content": "engenn1l