{"_data": [{"contents": [{"content": "Places and People", "type": "lesson_name"}, {"content": "What Does It Look Like?", "type": "unit_name"}, {"content": 7, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "Beginner", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Position of Adjectives", "type": "heading"}, {"content": "Colors and patterns describe things. They are adjectives. <br />They go before the noun, like <span class=\"italic\">the blue chair</span>,  or after some verbs, like <span class=\"italic\">the chair is beautiful</span>. </span><br />Patterns are shapes or designs that are repeated.", "type": "describer"}, {"content": "I like the red carpet. (before the noun)", "type": "example"}, {"content": "{\"rows\":\"5\",\"columns\":\"3\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Colors</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Patterns</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Example of Patterns</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"blue\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"floral\\\"}\",\"{\\\"type\\\": \\\"image\\\", \\\"content\\\": \\\"engenn1le03ob07img05.jpg\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"red\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"solid\\\"}\",\"{\\\"type\\\": \\\"image\\\", \\\"content\\\": \\\"engenn1le03ob07img06.jpg\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"red and white\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"printed\\\"}\",\"{\\\"type\\\": \\\"image\\\", \\\"content\\\": \\\"engenn1le03ob07img07.jpg\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"grey\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\